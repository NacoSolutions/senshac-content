{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senshac.example/contracts/site-config/v1",
  "title": "Senshac editable site configuration",
  "type": "object",
  "required": ["chrome"],
  "properties": {
    "chrome": { "$ref": "#/$defs/chrome" }
  },
  "$defs": {
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "footer"],
      "properties": {
        "header": { "$ref": "#/$defs/chromeElement" },
        "footer": { "$ref": "#/$defs/chromeElement" }
      }
    },
    "chromeElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "atFinal", "scrolling"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["fixed", "scrolling"]
        },
        "atFinal": { "$ref": "#/$defs/appearance" },
        "scrolling": { "$ref": "#/$defs/appearance" }
      }
    },
    "appearance": {
      "type": "string",
      "enum": [
        "transparent-adaptive",
        "transparent-light",
        "transparent-dark",
        "opaque-light",
        "opaque-dark"
      ]
    }
  }
}
